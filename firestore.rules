rules_version = '2';

// GuideHunter's Firestore rules (README, "Firebase"). Deploy with `firebase deploy --only firestore:rules`, or paste
// them in the Firebase console (Firestore Database → Rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // Published offers: anyone reads them. Written by approval (scripts/approve-offer.py); the guide who owns one
    // can only take it off the map.
    match /guides/{guideId} {
      allow read: if true;
      allow delete: if owns(resource.data);
      allow create, update: if false;
    }

    // A guide's name and contact, read one at a time after a rewarded ad. No listing, so the whole collection can't
    // be downloaded in one query. The ad itself is only checked in the app for now (FOLLOW-UP.md). The owner's
    // profile changes reach it (contact fields only), and the owner can delete it with the offer.
    match /guideContacts/{guideId} {
      allow get: if true;
      allow list, create: if false;
      allow update: if owns(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'website'])
        && validContact(request.resource.data);
      allow delete: if owns(resource.data);
    }

    // A guide's profile, by Firebase user id: only they read and write it.
    match /guideProfiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
    }

    // A guide's offers as they wrote them. Only they read and change them; every write goes back to waiting for
    // review, and only approval (scripts/approve-offer.py) publishes one or marks it live.
    match /guideOffers/{offerId} {
      // Reading one that doesn't exist (deleted on another phone) is allowed: the app sees it's gone.
      allow get: if resource == null || owns(resource.data);
      allow list, delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && validOffer(request.resource.data)
        && request.resource.data.live == false;
      allow update: if owns(resource.data) && owns(request.resource.data) && validOffer(request.resource.data)
        && request.resource.data.live == resource.data.live;
    }

    // Emails sent by the "Trigger Email from Firestore" extension. Signed-in guides can only send the offer email,
    // and only to you: anything else would let anyone use your mail account to send spam.
    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'replyTo', 'message'])
        && request.resource.data.to == 'contact@kallistesoft.ca' // keep in sync with APPLICATIONS_EMAIL
        && email(request.resource.data.replyTo)
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject is string && request.resource.data.message.subject.size() <= 300
        && request.resource.data.message.text is string && request.resource.data.message.text.size() <= 5000;
      allow read, update, delete: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // A document of the signed-in guide's.
    function owns(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function shortText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function email(value) {
      return shortText(value, 3, 200) && value.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+');
    }

    function phone(value) {
      return shortText(value, 0, 50) && value.matches('[0-9 +()\\-.]*');
    }

    function website(value) {
      return shortText(value, 0, 300) && value.matches('[^\\s]*');
    }

    function validProfile(data) {
      return data.keys().hasOnly(['businessName', 'email', 'phone', 'website'])
        && shortText(data.businessName, 1, 200)
        && email(data.email)
        && phone(data.phone)
        && website(data.website);
    }

    function validContact(data) {
      return shortText(data.name, 1, 200) && email(data.email) && phone(data.phone) && website(data.website);
    }

    function validOffer(data) {
      return data.keys().hasOnly([
          'ownerUid', 'title', 'description', 'activity', 'species', 'region', 'lat', 'lng', 'priceFrom', 'status',
          'live', 'updatedAt', 'tripLength', 'departures', 'everyYear'])
        && shortText(data.title, 1, 100)
        && shortText(data.description, 30, 2000)
        // One type per offer ('BOTH' only on older offers already on the map).
        && data.activity in ['HUNT', 'FISH']
        && data.species is list && data.species.size() >= 1 && data.species.size() <= 29
        && data.species.hasOnly([
          'BLACK_BEAR', 'MOOSE', 'WHITE_TAILED_DEER', 'MULE_DEER', 'ELK', 'CARIBOU', 'PRONGHORN', 'BIGHORN_SHEEP',
          'MOUNTAIN_GOAT', 'WILD_TURKEY', 'WATERFOWL', 'UPLAND_BIRDS', 'SHARP_TAILED_GROUSE', 'PHEASANT',
          'PREDATORS', 'WALLEYE', 'YELLOW_PERCH', 'NORTHERN_PIKE', 'BROOK_TROUT', 'RAINBOW_TROUT', 'LAKE_TROUT',
          'ARCTIC_CHAR', 'ATLANTIC_SALMON', 'PACIFIC_SALMON', 'SMALLMOUTH_BASS', 'LARGEMOUTH_BASS', 'MUSKELLUNGE',
          'STURGEON', 'ICE_FISHING']) // keep in sync with core/model Species
        && shortText(data.region, 1, 200)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (data.priceFrom == null || (data.priceFrom is int && data.priceFrom > 0 && data.priceFrom <= 999999))
        // The trip's length ('HALF_DAY' or days), its departures (ISO dates, '/AM' or '/PM' on a half day) and
        // whether they come back every year: see core/model Schedule; the app checks each departure.
        && (!('tripLength' in data) || data.tripLength == null || data.tripLength == 'HALF_DAY'
          || (data.tripLength is int && data.tripLength >= 1 && data.tripLength <= 60))
        && (!('departures' in data) || (data.departures is list && data.departures.size() <= 60))
        && (!('everyYear' in data) || data.everyYear is bool)
        && data.status == 'PENDING'
        && data.live is bool
        && data.updatedAt == request.time;
    }
  }
}
