rules_version = '2';

// GuideHunter's Firestore rules (README, "Firebase"). Deploy with `firebase deploy --only firestore:rules`, or paste
// them in the Firebase console (Firestore Database → Rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // Published offers: anyone reads them. Written by approval (scripts/approve-offer.py); the guide who owns one
    // can take it off the map, or boost it: set `boostedUntil`, and nothing else, to at most 3 days from now (the
    // 10 minutes cover a phone's clock slightly off). The ad watched for it is only checked in the app for now
    // (FOLLOW-UP.md): a guide could renew without the ad, but never more than 3 days ahead.
    match /guides/{guideId} {
      allow read: if true;
      allow delete: if owns(resource.data);
      allow update: if owns(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boostedUntil'])
        && request.resource.data.boostedUntil is timestamp
        && request.resource.data.boostedUntil > request.time
        && request.resource.data.boostedUntil <= request.time + duration.value(3, 'd') + duration.value(10, 'm');
      allow create: if false;
    }

    // A guide's name and contact, by offer: written by approval, kept for later. The app no longer reads it (users get
    // a guide's contact once their request is accepted), so only its guide can. The owner's profile changes reach it
    // (contact fields only), and the owner can delete it with the offer.
    match /guideContacts/{guideId} {
      allow get: if owns(resource.data);
      allow list, create: if false;
      allow update: if owns(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'website'])
        && validContact(request.resource.data);
      allow delete: if owns(resource.data);
    }

    // A guide's profile, by Firebase user id: only they read and write it.
    match /guideProfiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
    }

    // A guide's offers as they wrote them. Only they read and change them; every write goes back to waiting for
    // review, and only approval (scripts/approve-offer.py) publishes one or marks it live.
    match /guideOffers/{offerId} {
      // Reading one that doesn't exist (deleted on another phone) is allowed: the app sees it's gone.
      allow get: if resource == null || owns(resource.data);
      allow list, delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && validOffer(request.resource.data)
        && request.resource.data.live == false;
      allow update: if owns(resource.data) && owns(request.resource.data) && validOffer(request.resource.data)
        && request.resource.data.live == resource.data.live;
    }

    // A user's contact (what they share with a guide), by Firebase user id: only they read and write it. The email is
    // their Google account's.
    match /userProfiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone'])
        && shortText(request.resource.data.name, 1, 200)
        && request.resource.data.email == request.auth.token.email
        && phone(request.resource.data.phone);
    }

    // "I'm interested": a user's request for an offer, one per offer and user (id `offerId_userUid`). The user and the
    // guide read it; each side makes only its own changes. The ad before it is only checked in the app (FOLLOW-UP.md).
    match /requests/{requestId} {
      // A request not sent yet reads as missing (the offer's sheet listens for it).
      allow get: if signedIn() && (resource == null || party(resource.data));
      // Only the user's or the guide's own: the app's queries filter on userUid or guideUid.
      allow list: if party(resource.data);
      allow create: if signedIn()
        && requestId == request.resource.data.offerId + '_' + request.auth.uid
        && newRequest(request.resource.data);
      allow update: if userChange() || guideChange();
      // With the user's account.
      allow delete: if signedIn() && resource.data.userUid == request.auth.uid;
    }

    // Emails sent by the "Trigger Email from Firestore" extension. Signed-in guides can only send the offer email,
    // and only to you: anything else would let anyone use your mail account to send spam.
    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'replyTo', 'message'])
        && request.resource.data.to == 'contact@kallistesoft.ca' // keep in sync with APPLICATIONS_EMAIL
        && email(request.resource.data.replyTo)
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject is string && request.resource.data.message.subject.size() <= 300
        && request.resource.data.message.text is string && request.resource.data.message.text.size() <= 5000;
      allow read, update, delete: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // A document of the signed-in guide's.
    function owns(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function shortText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function email(value) {
      return shortText(value, 3, 200) && value.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+');
    }

    function phone(value) {
      return shortText(value, 0, 50) && value.matches('[0-9 +()\\-.]*');
    }

    function website(value) {
      return shortText(value, 0, 300) && value.matches('[^\\s]*');
    }

    function validProfile(data) {
      return data.keys().hasOnly(['businessName', 'email', 'phone', 'website'])
        && shortText(data.businessName, 1, 200)
        && email(data.email)
        && phone(data.phone)
        && website(data.website);
    }

    function validContact(data) {
      return shortText(data.name, 1, 200) && email(data.email) && phone(data.phone) && website(data.website);
    }

    // The user or the guide of a request.
    function party(data) {
      return signedIn() && (data.userUid == request.auth.uid || data.guideUid == request.auth.uid);
    }

    // What the user shares in a request: a name, their Google account's email, an optional phone.
    function validRequester(data) {
      return shortText(data.userName, 1, 200)
        && data.userEmail == request.auth.token.email
        && phone(data.userPhone);
    }

    // The trip the user chose: ISO dates (or none: dates on request), 'AM' or 'PM' on a half day.
    function validTrip(data) {
      return (data.tripStart == null || (data.tripStart is string && data.tripStart.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (data.tripEnd == null || (data.tripEnd is string && data.tripEnd.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && data.tripSlot in [null, 'AM', 'PM'];
    }

    // A new request: the user's own, pending, to the guide and with the title of the published offer (so neither can
    // be made up), never to their own offer.
    function newRequest(data) {
      let offer = get(/databases/$(database)/documents/guides/$(data.offerId)).data;
      return data.keys().hasOnly([
          'offerId', 'offerTitle', 'tripStart', 'tripEnd', 'tripSlot', 'guideUid', 'userUid', 'userName', 'userEmail',
          'userPhone', 'status', 'createdAt', 'updatedAt'])
        && data.userUid == request.auth.uid
        && data.status == 'PENDING'
        && validRequester(data)
        && validTrip(data)
        && data.guideUid == offer.ownerUid
        && data.offerTitle == offer.title
        && data.guideUid != data.userUid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // The fields a request update changes.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function statusChange(from, to) {
      return resource.data.status in from && request.resource.data.status == to
        && request.resource.data.updatedAt == request.time;
    }

    // The user cancels a pending or accepted request, or sends a cancelled one again with their contact and trip as
    // they are now.
    function userChange() {
      return signedIn() && resource.data.userUid == request.auth.uid
        && ((statusChange(['PENDING', 'APPROVED'], 'CANCELLED') && changed().hasOnly(['status', 'updatedAt']))
          || (statusChange(['CANCELLED'], 'PENDING')
            && changed().hasOnly(['status', 'updatedAt', 'userName', 'userEmail', 'userPhone', 'tripStart', 'tripEnd', 'tripSlot'])
            && validRequester(request.resource.data)
            && validTrip(request.resource.data)));
    }

    // The guide accepts a pending request (giving their contact) or declines it, and closes the open ones when the
    // offer or their account is deleted.
    function guideChange() {
      let data = request.resource.data;
      return signedIn() && resource.data.guideUid == request.auth.uid
        && ((statusChange(['PENDING'], 'APPROVED')
            && changed().hasOnly(['status', 'updatedAt', 'guideName', 'guideEmail', 'guidePhone', 'guideWebsite'])
            && shortText(data.guideName, 1, 200) && email(data.guideEmail) && phone(data.guidePhone) && website(data.guideWebsite))
          || (statusChange(['PENDING'], 'REJECTED') && changed().hasOnly(['status', 'updatedAt']))
          || (statusChange(['PENDING', 'APPROVED'], 'OFFER_REMOVED') && changed().hasOnly(['status', 'updatedAt'])));
    }

    function validOffer(data) {
      return data.keys().hasOnly([
          'ownerUid', 'title', 'description', 'activity', 'species', 'region', 'lat', 'lng', 'priceFrom', 'status',
          'live', 'updatedAt', 'tripLength', 'departures', 'everyYear'])
        && shortText(data.title, 1, 100)
        && shortText(data.description, 30, 2000)
        // One type per offer ('BOTH' only on older offers already on the map).
        && data.activity in ['HUNT', 'FISH']
        && data.species is list && data.species.size() >= 1 && data.species.size() <= 29
        && data.species.hasOnly([
          'BLACK_BEAR', 'MOOSE', 'WHITE_TAILED_DEER', 'MULE_DEER', 'ELK', 'CARIBOU', 'PRONGHORN', 'BIGHORN_SHEEP',
          'MOUNTAIN_GOAT', 'WILD_TURKEY', 'WATERFOWL', 'UPLAND_BIRDS', 'SHARP_TAILED_GROUSE', 'PHEASANT',
          'PREDATORS', 'WALLEYE', 'YELLOW_PERCH', 'NORTHERN_PIKE', 'BROOK_TROUT', 'RAINBOW_TROUT', 'LAKE_TROUT',
          'ARCTIC_CHAR', 'ATLANTIC_SALMON', 'PACIFIC_SALMON', 'SMALLMOUTH_BASS', 'LARGEMOUTH_BASS', 'MUSKELLUNGE',
          'STURGEON', 'ICE_FISHING']) // keep in sync with core/model Species
        && shortText(data.region, 1, 200)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (data.priceFrom == null || (data.priceFrom is int && data.priceFrom > 0 && data.priceFrom <= 999999))
        // The trip's length ('HALF_DAY' or days), its departures (ISO dates, '/AM' or '/PM' on a half day) and
        // whether they come back every year: see core/model Schedule; the app checks each departure.
        && (!('tripLength' in data) || data.tripLength == null || data.tripLength == 'HALF_DAY'
          || (data.tripLength is int && data.tripLength >= 1 && data.tripLength <= 60))
        && (!('departures' in data) || (data.departures is list && data.departures.size() <= 60))
        && (!('everyYear' in data) || data.everyYear is bool)
        && data.status == 'PENDING'
        && data.live is bool
        && data.updatedAt == request.time;
    }
  }
}
